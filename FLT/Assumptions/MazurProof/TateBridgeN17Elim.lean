    - C 9777 * X ^ 4 + C 2458 * X ^ 3 + C 653 * X ^ 2 + C 47 * X + C 1

open Polynomial in
def fib17_2_poly : Polynomial ℤ :=
  X ^ 8 + C 426 * X ^ 7 - C 34296 * X ^ 6 - C 39072 * X ^ 5
    + C 190347 * X ^ 4 - C 12536 * X ^ 3 - C 1489 * X ^ 2 + C 47 * X + C 1

theorem fib17_1_poly_monic : fib17_1_poly.Monic := by
  unfold fib17_1_poly; monicity!

theorem fib17_2_poly_monic : fib17_2_poly.Monic := by
  unfold fib17_2_poly; monicity!

theorem fib17_1_no_root_mod2 (z : ZMod 2) : aeval z fib17_1_poly ≠ 0 := by
  fin_cases z <;> simp [fib17_1_poly, aeval_def] <;> decide

theorem fib17_2_no_root_mod2 (z : ZMod 2) : aeval z fib17_2_poly ≠ 0 := by
  fin_cases z <;> simp [fib17_2_poly, aeval_def] <;> decide

theorem fib17_1_no_rational_root (x : ℚ) : aeval x fib17_1_poly ≠ 0 := by
  intro hx
  obtain ⟨z, hz, _⟩ := exists_integer_of_is_root_of_monic fib17_1_poly_monic hx
  have hint : aeval z fib17_1_poly = 0 := by
    have h : aeval (algebraMap ℤ ℚ z) fib17_1_poly = 0 := hz ▸ hx
    rw [aeval_algebraMap_apply] at h
    exact (IsFractionRing.injective ℤ ℚ) (h.trans (map_zero _).symm)
  have hmod : aeval (algebraMap ℤ (ZMod 2) z) fib17_1_poly = 0 := by
    rw [aeval_algebraMap_apply, hint, map_zero]
  exact fib17_1_no_root_mod2 _ hmod

theorem fib17_2_no_rational_root (x : ℚ) : aeval x fib17_2_poly ≠ 0 := by
  intro hx
  obtain ⟨z, hz, _⟩ := exists_integer_of_is_root_of_monic fib17_2_poly_monic hx
  have hint : aeval z fib17_2_poly = 0 := by
    have h : aeval (algebraMap ℤ ℚ z) fib17_2_poly = 0 := hz ▸ hx
    rw [aeval_algebraMap_apply] at h
    exact (IsFractionRing.injective ℤ ℚ) (h.trans (map_zero _).symm)
  have hmod : aeval (algebraMap ℤ (ZMod 2) z) fib17_2_poly = 0 := by
    rw [aeval_algebraMap_apply, hint, map_zero]
  exact fib17_2_no_root_mod2 _ hmod

theorem fib17_1_eval_eq (c : ℚ) : fib17_1 c = aeval c fib17_1_poly := by
  simp [fib17_1, fib17_1_poly, aeval_def, eval_map]
  ring

theorem fib17_2_eval_eq (c : ℚ) : fib17_2 c = aeval c fib17_2_poly := by
  simp [fib17_2, fib17_2_poly, aeval_def, eval_map]
  ring

theorem no_tate_order17_case1 (b c : ℚ) (hb : b ≠ 0) (hF : F17 b c = 0)
    (hA : A17 b c = 11 * c ^ 28) : False := by
  have hc := c_ne_zero_of_F17 b c hb hF
  have hcert := elim_certificate_17 b c
  rw [hF, hA] at hcert
  have hzero : c ^ 53 * fib17_1 c * fib17_2 c = 0 := by linarith
  have hc53 : c ^ 53 ≠ 0 := pow_ne_zero 53 hc
  -- hzero : (c^53 * fib17_1 c) * fib17_2 c = 0
  rcases mul_eq_zero.mp hzero with h12 | h2
  · rcases mul_eq_zero.mp h12 with h0 | h1
    · exact hc53 h0
    · exact fib17_1_no_rational_root c (fib17_1_eval_eq c ▸ h1)
  · exact fib17_2_no_rational_root c (fib17_2_eval_eq c ▸ h2)

end

